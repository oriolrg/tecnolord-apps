generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING
  COMPLETED
  PARTIAL
  SKIPPED
  SUBSTITUTED
  REST
}

enum SessionType {
  STRENGTH
  SWIM
  BIKE
  TRAIL
  WALK
  MOBILITY
  GARDEN
  REST
  COMBINED
  INTENSITY
  OUTDOOR
}

enum ProviderType {
  JSON
  CSV
  GPX
  FIT
  STRAVA
  GARMIN
  POLAR
  SUUNTO
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  name                        String?
  image                       String?
  timezone                    String                       @default("Europe/Madrid")
  weeklyAvailability          Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  trainingPlans               TrainingPlan[]
  workoutLogs                 WorkoutLog[]
  importedActivities          ImportedActivity[]
  weeklySummaries             WeeklySummary[]
  activityProviderConnections ActivityProviderConnection[]
}

model TrainingPlan {
  id                String           @id @default(cuid())
  userId            String
  name              String
  month             DateTime
  metadata          Json
  targetProfile     Json
  replanningRules   Json
  intensityCriteria Json?
  aiNotes           Json?
  sourceJson        Json
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSessions   PlannedSession[]
}

model PlannedSession {
  id                    String            @id @default(cuid())
  trainingPlanId        String
  date                  DateTime
  title                 String
  type                  SessionType
  status                SessionStatus     @default(PENDING)
  plannedDurationMin    Int?
  plannedDistanceKm     Float?
  plannedElevationM     Int?
  plannedRpe            Int?
  plannedZone           String?
  availableAlternatives Json?
  blocks                Json
  notes                 String?
  trainingPlan          TrainingPlan      @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  workoutLogs           WorkoutLog[]
  importedActivities    ImportedActivity[]

  @@unique([trainingPlanId, date])
}

model Exercise {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  muscleGroup         String
  equipment           String[]
  technicalCues       String[]
  commonErrors        String[]
  mediaUrl            String?
  mediaType           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WorkoutLog {
  id                    String           @id @default(cuid())
  userId                String
  plannedSessionId      String?
  date                  DateTime
  status                SessionStatus
  durationMin           Int?
  distanceKm            Float?
  elevationGainM        Int?
  calories              Int?
  avgHeartRate          Int?
  maxHeartRate          Int?
  rpe                   Int?
  notes                 String?
  painLevel             Int?
  painNotes             String?
  sleepQuality          Int?
  fatigueLevel          Int?
  perceivedStress       Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSession        PlannedSession?  @relation(fields: [plannedSessionId], references: [id], onDelete: SetNull)
}

model ImportedActivity {
  id                    String           @id @default(cuid())
  userId                String
  plannedSessionId      String?
  providerType          ProviderType
  externalId            String?
  activityType          SessionType
  sourceFilename        String?
  date                  DateTime
  durationMin           Int
  distanceKm            Float?
  elevationGainM        Int?
  avgPace               Float?
  avgPower              Int?
  avgHeartRate          Int?
  maxHeartRate          Int?
  calories              Int?
  laps                  Json?
  rawPayload            Json
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSession        PlannedSession?  @relation(fields: [plannedSessionId], references: [id], onDelete: SetNull)
}

model WeeklySummary {
  id                    String   @id @default(cuid())
  userId                String
  weekStart             DateTime
  complianceRate        Float
  plannedSessionsCount  Int
  completedSessionsCount Int
  totalHours            Float
  estimatedLoad         Int
  fatigueTrend          String?
  highlightedNotes      String[]
  alerts                String[]
  rawMetrics            Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

model ActivityProviderConnection {
  id            String       @id @default(cuid())
  userId        String
  providerType  ProviderType
  providerUserId String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerType])
}
