tecnolord.cat, www.tecnolord.cat {
  encode gzip zstd

  # 1) APIs específiques
  handle_path /api/pap* {
    reverse_proxy pap_backend:6000
  }

  handle_path /api/orienta* {
    reverse_proxy orientatrack:4000
  }

  handle_path /api/opos* {
    reverse_proxy opos_backend:5000
  }

  # 2) Frontends (subdirectoris)

  # PaP (si és frontend estàtic, aquí hauries de servir estàtics; si és backend, ok)
  handle_path /pap* {
    reverse_proxy pap_backend:6000
  }

  # ✅ OrientaTrack FRONTEND estàtic (SPA)
  handle_path /orientatrack* {
    # Si tens algun CSP massa restrictiu heretat, el traiem aquí
    header {
      -Content-Security-Policy
    }

    root * /srv/orientatrack
    try_files {path} /index.html
    file_server
  }

  # Opos (igual: si és frontend estàtic, canviar a file_server)
  handle_path /opos* {
    reverse_proxy opos_backend:5000
  }

  # 3) Rutes preexistents (MeteoLord i IA)
  @py path /api/v1/kpis* /api/v1/forecast* /health
  handle @py {
    reverse_proxy api_py:8000
  }

  @api path /api/* /api/v1/*
  handle @api {
    reverse_proxy backend:3000
  }

  handle_path /meteo* {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  # 4) Redirecció d'arrel
  handle / {
    redir /meteo/ 302
  }
}

stats.tecnolord.cat {
  encode gzip zstd
  reverse_proxy umami:3000
}