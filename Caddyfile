:80 {
  encode gzip zstd

  # PYTHON API (manté el path complet)
  handle /api/v1/* {
    reverse_proxy api_py:8000
  }

  # NODE legacy (si cal)
  handle /api/* {
    reverse_proxy backend:3000
  }

  # Arrel -> /meteo (opcional)
  redir / /meteo/ 302

  # STATIC només a /meteo
  handle_path /meteo* {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  # Resta -> 404 (evita que / segueixi servint estàtics)
  respond "Not found" 404
}
