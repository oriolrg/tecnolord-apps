tecnolord.cat, www.tecnolord.cat {
  encode gzip zstd

  # --- APIs ---
  handle_path /api/pap* {
    reverse_proxy pap_backend:6000
  }

  # L'API d'OrientaTrack
  handle_path /api/orienta* {
    reverse_proxy orientatrack:4000
  }

  handle_path /api/opos* {
    reverse_proxy opos_backend:5000
  }

  # --- FRONTENDS ---

  # OrientaTrack (Frontend + Backend unificats)
  # Fem servir handle (sense path) per passar la ruta sencera a Node
  handle /orientatrack* {
    header -Content-Security-Policy
    reverse_proxy orientatrack:4000
  }

  handle_path /pap* {
    reverse_proxy pap_backend:6000
  }

  handle_path /opos* {
    reverse_proxy opos_backend:5000
  }

  # --- Altres ---
  handle_path /meteo* {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  handle / {
    redir /meteo/ 302
  }
}

stats.tecnolord.cat {
  encode gzip zstd
  reverse_proxy umami:3000
}