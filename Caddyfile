tecnolord.cat, www.tecnolord.cat {
  encode gzip zstd

  # 1. Rutes ultra-específiques (APIs de nous projectes)
  # Les posem primer perquè Caddy no les confongui amb l'API genèrica
  
  handle_path /api/pap* {
    reverse_proxy pap_backend:6000
  }

  handle_path /api/orienta* {
    reverse_proxy orientatrack:4000
  }

  handle_path /api/opos* {
    reverse_proxy opos_backend:5000
  }

  # 2. Rutes de Frontend (Subdirectoris)
  handle_path /pap* {
    reverse_proxy pap_backend:6000
  }

  handle_path /orientatrack* {
    reverse_proxy orientatrack:4000
  }

  handle_path /opos* {
    reverse_proxy opos_backend:5000
  }

  # 3. Rutes preexistents (MeteoLord i IA)
  @py path /api/v1/kpis* /api/v1/forecast* /health
  handle @py {
    reverse_proxy api_py:8000
  }

  @api path /api/* /api/v1/*
  handle @api {
    reverse_proxy backend:3000
  }

  handle_path /meteo* {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  # 4. Redireccions d'arrel
  handle / {
    redir /meteo/ 302
  }
}

stats.tecnolord.cat {
  encode gzip zstd
  reverse_proxy umami:3000
}