tecnolord.cat, www.tecnolord.cat {
  encode gzip zstd

  # --- APIs específiques ---
  handle_path /api/pap* {
    reverse_proxy pap_backend:6000
  }

  handle_path /api/orienta* {
    reverse_proxy orientatrack:4000
  }

  handle_path /api/opos* {
    reverse_proxy opos_backend:5000
  }

  # --- FRONTENDS (subdirectoris) ---

  # OrientaTrack FRONTEND estàtic (SPA/PWA)
  handle_path /orientatrack* {
    # Per evitar CSP heretat o headers que trenquin scripts
    header {
      -Content-Security-Policy
    }

    root * /srv/orientatrack
    try_files {path} /index.html
    file_server
  }

  # PaP (ara mateix el tens com a backend; si és frontend, canvia'l com orientatrack)
  handle_path /pap* {
    reverse_proxy pap_backend:6000
  }

  # Opos (idem)
  handle_path /opos* {
    reverse_proxy opos_backend:5000
  }

  # --- Rutes preexistents (MeteoLord i IA) ---
  @py path /api/v1/kpis* /api/v1/forecast* /health
  handle @py {
    reverse_proxy api_py:8000
  }

  @api path /api/* /api/v1/*
  handle @api {
    reverse_proxy backend:3000
  }

  handle_path /meteo* {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  # --- Redirecció d'arrel ---
  handle / {
    redir /meteo/ 302
  }
}

stats.tecnolord.cat {
  encode gzip zstd
  reverse_proxy umami:3000
}