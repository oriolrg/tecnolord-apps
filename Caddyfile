tecnolord.cat, www.tecnolord.cat {
  encode gzip zstd

  # --- APIs específiques ---
  handle_path /api/pap* {
    reverse_proxy pap_backend:6000
  }

  # Unifiquem l'API d'OrientaTrack al port 4000 (com hem posat al teu index.js)
  handle_path /api/orienta* {
    reverse_proxy orientatrack:4000
  }

  handle /api/opos* {
    reverse_proxy opos_web:3000
  }

  # --- FRONTENDS (subdirectoris) ---
  redir /iblioteca /biblioteca/ 301
  redir /biblioteca /biblioteca/ 301

  # 1. Forçar la barra final perquè el navegador sàpiga on és
  redir /orientatrack /orientatrack/
  # OrientaTrack: DELEGEM TOT A NODE.JS
  # Ja no usem /srv/, així Express serveix el JS de la seva carpeta 'public'
  handle_path /orientatrack* {
    header -Content-Security-Policy
    reverse_proxy orientatrack:4000
  }

  # PaP (Porta a Porta)
  handle_path /pap* {
    reverse_proxy pap_backend:6000
  }

  # Opos
  handle /_next/* {
    reverse_proxy opos_web:3000
  }

  handle /opos* {
    reverse_proxy opos_web:3000
  }

  handle /biblioteca* {
    reverse_proxy biblioteca_web:3000
  }

  # --- Rutes preexistents (MeteoLord i IA) ---
  @py path /api/v1/kpis* /api/v1/forecast* /health
  handle @py {
    reverse_proxy api_py:8000
  }

  @api path /api/* /api/v1/*
  handle @api {
    reverse_proxy backend:3000
  }

  @meteo_runtime path /meteo/runtime-config.js
  handle @meteo_runtime {
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.tecnolord.cat; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://tile.openstreetmap.org https://stats.tecnolord.cat; font-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    header Cache-Control "no-store, max-age=0"
    root * /srv
    rewrite * /runtime-config.production.js
    file_server
  }

  handle_path /meteo* {
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.tecnolord.cat; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://tile.openstreetmap.org https://stats.tecnolord.cat; font-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    header Cache-Control "no-cache, max-age=0, must-revalidate"
    root * /srv
    try_files {path} /index.html
    file_server
  }

  # --- Redirecció d'arrel ---
  handle / {
    redir /meteo/ 302
  }
}

entrenador.tecnolord.cat {
  encode gzip zstd
  reverse_proxy entrenador_personal_web:3000
}

stats.tecnolord.cat {
  encode gzip zstd
  reverse_proxy umami:3000
}
