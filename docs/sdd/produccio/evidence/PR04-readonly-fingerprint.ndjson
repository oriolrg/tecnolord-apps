{"kind": "view", "name": "ml_station_daily", "schema": "meteo", "section": "view_definition", "definition": " WITH hourly AS (\n         SELECT e.codi AS station_code,\n            date_trunc('hour'::text, m.instant) AS hour_ts,\n            avg(m.temp_c) AS temp_c,\n            avg(m.humitat_pct)::double precision AS hum_pct,\n            avg(m.pressio_rel_hpa) AS press_hpa,\n            sum(COALESCE(m.pluja_hora_mm, 0::real))::double precision AS rain_mm_h,\n            avg(m.vent_ms) AS wind_ms,\n            avg(m.vent_direccio_graus)::double precision AS wind_dir_deg,\n            avg(m.solar_wm2) AS solar_wm2,\n            avg(m.uvi)::double precision AS uvi\n           FROM mesures m\n             JOIN estacions e ON e.id = m.estacio_id\n          GROUP BY e.codi, (date_trunc('hour'::text, m.instant))\n        ), hourly_feat AS (\n         SELECT hourly.station_code,\n            hourly.hour_ts,\n            hourly.temp_c,\n            hourly.hum_pct,\n            hourly.press_hpa,\n            hourly.rain_mm_h,\n            hourly.wind_ms,\n            hourly.wind_dir_deg,\n            hourly.solar_wm2,\n            hourly.uvi,\n            hourly.press_hpa - lag(hourly.press_hpa, 3) OVER (PARTITION BY hourly.station_code ORDER BY hourly.hour_ts) AS dpress_3h,\n            hourly.press_hpa - lag(hourly.press_hpa, 6) OVER (PARTITION BY hourly.station_code ORDER BY hourly.hour_ts) AS dpress_6h\n           FROM hourly\n        ), daily AS (\n         SELECT hourly_feat.station_code,\n            date_trunc('day'::text, hourly_feat.hour_ts) AS day,\n            sum(hourly_feat.rain_mm_h) AS obs_rain_day_mm,\n            avg(hourly_feat.temp_c) AS temp_mean,\n            min(hourly_feat.temp_c) AS temp_min,\n            max(hourly_feat.temp_c) AS temp_max,\n            avg(hourly_feat.hum_pct) AS hum_mean,\n            min(hourly_feat.hum_pct) AS hum_min,\n            max(hourly_feat.hum_pct) AS hum_max,\n            avg(hourly_feat.press_hpa) AS press_mean,\n            min(hourly_feat.press_hpa) AS press_min,\n            max(hourly_feat.press_hpa) AS press_max,\n            avg(hourly_feat.dpress_3h) AS dpress3_mean,\n            min(hourly_feat.dpress_3h) AS dpress3_min,\n            avg(hourly_feat.dpress_6h) AS dpress6_mean,\n            min(hourly_feat.dpress_6h) AS dpress6_min,\n            avg(hourly_feat.wind_ms) AS wind_mean,\n            max(hourly_feat.wind_ms) AS wind_max,\n            avg(hourly_feat.solar_wm2) AS solar_mean,\n            max(hourly_feat.solar_wm2) AS solar_max,\n            avg(hourly_feat.uvi) AS uvi_mean,\n            max(hourly_feat.uvi) AS uvi_max\n           FROM hourly_feat\n          GROUP BY hourly_feat.station_code, (date_trunc('day'::text, hourly_feat.hour_ts))\n        )\n SELECT station_code,\n    day,\n    obs_rain_day_mm,\n    temp_mean,\n    temp_min,\n    temp_max,\n    hum_mean,\n    hum_min,\n    hum_max,\n    press_mean,\n    press_min,\n    press_max,\n    dpress3_mean,\n    dpress3_min,\n    dpress6_mean,\n    dpress6_min,\n    wind_mean,\n    wind_max,\n    solar_mean,\n    solar_max,\n    uvi_mean,\n    uvi_max,\n        CASE\n            WHEN obs_rain_day_mm >= 1.0::double precision THEN 1\n            ELSE 0\n        END AS rain_day,\n    EXTRACT(month FROM day) AS month,\n    EXTRACT(doy FROM day) AS doy\n   FROM daily d;"}
{"kind": "view", "name": "ml_station_daily_shifted", "schema": "meteo", "section": "view_definition", "definition": " SELECT station_code,\n    day AS feature_day,\n    temp_mean,\n    temp_min,\n    temp_max,\n    hum_mean,\n    hum_min,\n    hum_max,\n    press_mean,\n    press_min,\n    press_max,\n    dpress3_mean,\n    dpress3_min,\n    dpress6_mean,\n    dpress6_min,\n    wind_mean,\n    wind_max,\n    solar_mean,\n    solar_max,\n    uvi_mean,\n    uvi_max,\n    month,\n    doy,\n    lead(rain_day, 1) OVER (PARTITION BY station_code ORDER BY day) AS rain_day_next\n   FROM ml_station_daily\n  WHERE station_code = 'home'::text;"}
{"kind": "view", "name": "ml_training_daily", "schema": "meteo", "section": "view_definition", "definition": " WITH base AS (\n         SELECT ml_training_hourly.station_code,\n            date_trunc('day'::text, ml_training_hourly.valid_time) AS day,\n            sum(ml_training_hourly.obs_rain_mm) AS obs_rain_day,\n            sum(ml_training_hourly.fcst_rain_mm) AS fcst_rain_day,\n            avg(ml_training_hourly.fcst_hum_pct) AS fcst_humidity_day,\n            avg(ml_training_hourly.delta_pressure_3h) AS mean_delta_pressure_3h,\n            min(ml_training_hourly.delta_pressure_3h) AS min_delta_pressure_3h,\n            EXTRACT(month FROM ml_training_hourly.valid_time) AS month\n           FROM ml_training_hourly\n          WHERE ml_training_hourly.station_code = 'home'::text AND ml_training_hourly.fcst_temp_c IS NOT NULL\n          GROUP BY ml_training_hourly.station_code, (date_trunc('day'::text, ml_training_hourly.valid_time)), (EXTRACT(month FROM ml_training_hourly.valid_time))\n        )\n SELECT station_code,\n    day,\n    obs_rain_day,\n    fcst_rain_day,\n    fcst_humidity_day,\n    mean_delta_pressure_3h,\n    min_delta_pressure_3h,\n    month,\n        CASE\n            WHEN obs_rain_day >= 1::double precision THEN 1\n            ELSE 0\n        END AS rain_day\n   FROM base;"}
{"kind": "view", "name": "ml_training_hourly", "schema": "meteo", "section": "view_definition", "definition": " WITH obs AS (\n         SELECT e.codi AS station_code,\n            date_trunc('hour'::text, m.instant) AS valid_time,\n            avg(m.temp_c) AS obs_temp_c,\n            avg(m.humitat_pct)::double precision AS obs_humidity,\n            avg(m.pressio_rel_hpa) AS obs_pressure_hpa,\n            sum(m.pluja_hora_mm)::double precision AS obs_rain_mm,\n            avg(m.vent_ms) AS obs_wind_speed_ms,\n            avg(m.vent_direccio_graus)::double precision AS obs_wind_dir_deg\n           FROM mesures m\n             JOIN estacions e ON e.id = m.estacio_id\n          GROUP BY e.codi, (date_trunc('hour'::text, m.instant))\n        ), obs_with_trend AS (\n         SELECT obs.station_code,\n            obs.valid_time,\n            obs.obs_temp_c,\n            obs.obs_humidity,\n            obs.obs_pressure_hpa,\n            obs.obs_rain_mm,\n            obs.obs_wind_speed_ms,\n            obs.obs_wind_dir_deg,\n            obs.obs_pressure_hpa - lag(obs.obs_pressure_hpa, 3) OVER (PARTITION BY obs.station_code ORDER BY obs.valid_time) AS delta_pressure_3h\n           FROM obs\n        ), fcst AS (\n         SELECT fr.station_code,\n            fr.source,\n            fr.model,\n            fr.issued_at,\n            fh.valid_time,\n            fh.temp_c::double precision AS fcst_temp_c,\n            fh.hum_pct::double precision AS fcst_hum_pct,\n            fh.wind_ms::double precision AS fcst_wind_ms,\n            fh.wind_dir::double precision AS fcst_wind_dir,\n            fh.rain_mm::double precision AS fcst_rain_mm\n           FROM forecast_run fr\n             JOIN forecast_hourly fh ON fh.run_id = fr.id\n        )\n SELECT o.station_code,\n    o.valid_time,\n    o.obs_temp_c,\n    o.obs_humidity,\n    o.obs_pressure_hpa,\n    o.delta_pressure_3h,\n    o.obs_rain_mm,\n    o.obs_wind_speed_ms,\n    o.obs_wind_dir_deg,\n    f.source,\n    f.model,\n    f.issued_at AS fcst_issued_at,\n    f.fcst_temp_c,\n    f.fcst_hum_pct,\n    f.fcst_wind_ms,\n    f.fcst_wind_dir,\n    f.fcst_rain_mm\n   FROM obs_with_trend o\n     LEFT JOIN LATERAL ( SELECT f_1.station_code,\n            f_1.source,\n            f_1.model,\n            f_1.issued_at,\n            f_1.valid_time,\n            f_1.fcst_temp_c,\n            f_1.fcst_hum_pct,\n            f_1.fcst_wind_ms,\n            f_1.fcst_wind_dir,\n            f_1.fcst_rain_mm\n           FROM fcst f_1\n          WHERE f_1.station_code = o.station_code AND f_1.valid_time = o.valid_time AND f_1.issued_at <= o.valid_time\n          ORDER BY f_1.issued_at DESC\n         LIMIT 1) f ON true;"}
{"kind": "view", "name": "pluja_any_v", "schema": "meteo", "section": "view_definition", "definition": " SELECT estacio_id,\n    EXTRACT(year FROM dia)::integer AS any_cal,\n    sum(pluja_dia_mm) AS acumulat_any_mm\n   FROM pluja_dia_v\n  GROUP BY estacio_id, (EXTRACT(year FROM dia));"}
{"kind": "view", "name": "pluja_dia_v", "schema": "meteo", "section": "view_definition", "definition": " WITH t AS (\n         SELECT mesures.estacio_id,\n            (mesures.instant AT TIME ZONE COALESCE(current_setting('meteo.tz'::text, true), 'Europe/Madrid'::text))::date AS dia,\n            mesures.pluja_diaria_mm\n           FROM mesures\n        )\n SELECT estacio_id,\n    dia,\n    max(pluja_diaria_mm) AS pluja_dia_mm\n   FROM t\n  GROUP BY estacio_id, dia;"}
{"kind": "view", "name": "pluja_diaria_v", "schema": "meteo", "section": "view_definition", "definition": " WITH base AS (\n         SELECT m.estacio_id,\n            (m.instant AT TIME ZONE 'Europe/Madrid'::text)::date AS dia,\n            m.instant,\n            m.pluja_diaria_mm,\n            lag(m.pluja_diaria_mm) OVER (PARTITION BY m.estacio_id, ((m.instant AT TIME ZONE 'Europe/Madrid'::text)::date) ORDER BY m.instant) AS prev\n           FROM mesures m\n        )\n SELECT estacio_id,\n    dia,\n    sum(\n        CASE\n            WHEN prev IS NULL THEN COALESCE(pluja_diaria_mm, 0::real)\n            WHEN pluja_diaria_mm >= prev THEN COALESCE(pluja_diaria_mm, 0::real) - COALESCE(prev, 0::real)\n            ELSE COALESCE(pluja_diaria_mm, 0::real)\n        END)::double precision AS total_diari_mm\n   FROM base\n  GROUP BY estacio_id, dia;"}
